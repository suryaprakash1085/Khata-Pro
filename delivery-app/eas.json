{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },

    "customer-preview": {
      "environment": "preview",
      "distribution": "internal",
      "node": "22.13.0",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "customer",
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },
    "driver-preview": {
      "environment": "preview",
      "distribution": "internal",
      "node": "22.13.0",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "driver",
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },
    "customer-prod": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "APP_VARIANT": "customer",
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    },
    "driver-prod": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "APP_VARIANT": "driver",
        "EAS_BUILD_PACKAGE_MANAGER": "pnpm",
        "EXPO_PUBLIC_API_BASE_URL": "https://khata-pro-ipct.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}